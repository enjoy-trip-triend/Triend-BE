<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.planner.mapper.PlannerLocationMapper">

  <insert id="insertLocation" parameterType="map">
    INSERT INTO planners_locations (planner_id, sido_code, gugun_code)
    VALUES
    <foreach collection="list" item="loc" index="idx" separator=",">
      (#{plannerId}, #{loc.sidoCode}, #{loc.gugunCode})
    </foreach>
  </insert>

  <delete id="deleteLocation" parameterType="Long">
    DELETE FROM planners_locations
    WHERE planner_id = #{plannerId}
  </delete>

  <resultMap type="com.ssafy.planner.dto.PlannerLocationDto" id="locationMap">
    <result column="sido_code" property="sidoCode" />
    <result column="gugun_code" property="gugunCode" />
  </resultMap>

</mapper>